    "suppliedHtml": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n<meta http-equiv=\"Content-Security-Policy\" \n      content=\"default-src 'self' data: https://cdnjs.cloudflare.com https://fonts.googleapis.com; \n               script-src 'self'; \n               style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; \n               font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com;\n               img-src 'self' data: https://cdn.simpleicons.org; \n               frame-ancestors 'none';\">\n               \n    <meta name=\"referrer\" content=\"strict-origin-when-cross-origin\">\n    <meta http-equiv=\"X-Content-Type-Options\" content=\"nosniff\">\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <title>Auberge de l'Est à l'Ouest</title>\n    <script src=\"script.js\" defer></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700&family=Oswald:wght@400;600&display=swap\" rel=\"stylesheet\">\n    \n    <style>\n        :root {\n            /* Palette Indus-Chic */\n            --bg-dark: #121212;\n            --bg-panel: rgba(30, 30, 30, 0.75);\n            --copper: #CD7F32; /* Couleur Cuivre */\n            --copper-light: #df9f5e;\n            --text-main: #E0E0E0;\n            --text-muted: #A0A0A0;\n            --border-color: rgba(205, 127, 50, 0.3);\n        }\n\n        * { box-sizing: border-box; margin: 0; padding: 0; }\n\n        body {\n            font-family: 'Montserrat', sans-serif;\n            background-color: var(--bg-dark);\n            /* Texture fixe */\n            background-image: \n                radial-gradient(circle at 50% 0%, #2a2a2a 0%, transparent 70%),\n                linear-gradient(45deg, #1a1a1a 25%, transparent 25%, transparent 75%, #1a1a1a 75%, #1a1a1a);\n            background-size: 100% 100%, 20px 20px;\n            color: var(--text-main);\n            height: 100vh;\n            width: 100vw;\n            overflow: hidden;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            padding: 15px;\n        }\n\n        /* --- CONTENEUR PRINCIPAL --- */\n        .glass-panel {\n            width: 100%;\n            max-width: 1000px;\n            max-height: 95vh;\n            background: var(--bg-panel);\n            backdrop-filter: blur(15px);\n            -webkit-backdrop-filter: blur(15px);\n            border: 1px solid var(--border-color);\n            border-radius: 4px;\n            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);\n            display: flex;\n            flex-direction: column;\n            overflow: hidden;\n        }\n\n        /* --- HEADER --- */\n        header {\n            flex: 0 0 auto;\n            text-align: center;\n            padding: 20px 20px 15px;\n            border-bottom: 1px solid rgba(255,255,255,0.05);\n            position: relative;\n        }\n\n        /* Décoration Vis (Coins) */\n        .screw {\n            position: absolute; width: 8px; height: 8px;\n            border-radius: 50%; border: 1px solid #555;\n            background: #333;\n            box-shadow: inset 1px 1px 2px black;\n        }\n        .screw::after { content: ''; position: absolute; top: 1px; left: 3px; width: 1px; height: 4px; background: #555; transform: rotate(45deg); }\n        .tl { top: 10px; left: 10px; } .tr { top: 10px; right: 10px; }\n\n        h1 {\n            font-family: 'Oswald', sans-serif;\n            font-size: clamp(1.6rem, 4vw, 2.8rem);\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 3px;\n            background: linear-gradient(to right, #fff, #bbb);\n            background-clip: text;\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            color: #fff;\n            margin-bottom: 8px;\n        }\n\n        .subtitle {\n            font-size: 0.85rem;\n            color: var(--copper);\n            text-transform: uppercase;\n            letter-spacing: 4px;\n            font-weight: 500;\n        }\n\n        /* --- LOGO ANIMÉ (Marmite) --- */\n        .blueprint-scene {\n            position: relative; width: 40px; height: 35px; margin: 0 auto 5px;\n        }\n        .bp-pot {\n            position: absolute; bottom: 0; left: 4px; width: 32px; height: 20px;\n            border: 2px solid var(--copper);\n            border-radius: 0 0 12px 12px;\n            background: transparent;\n            /* Animation vibration */\n            animation: boil 0.1s infinite alternate;\n        }\n        .bp-pot::before { /* Bord haut */\n            content: ''; position: absolute; top: -5px; left: -2px; width: 32px; height: 3px;\n            border: 2px solid var(--copper); border-radius: 4px;\n        }\n        .bp-lid {\n            position: absolute; bottom: 24px; left: 2px; width: 36px; height: 6px;\n            border: 2px solid var(--copper); border-bottom: none;\n            border-radius: 50% 50% 0 0;\n            /* Animation couvercle qui saute */\n            transform-origin: bottom center;\n            animation: rattle 0.1s infinite;\n        }\n        /* Ajout de la vapeur */\n        .bp-steam {\n            position: absolute; bottom: 30px; left: 50%; width: 2px; height: 8px;\n            background: var(--copper-light); opacity: 0;\n            animation: rise 2s infinite ease-out;\n        }\n        .bp-steam:nth-child(2) { animation-delay: 0.6s; left: 35%; height: 6px; }\n\n        /* --- KEYFRAMES D'ANIMATION --- */\n        @keyframes boil {\n            from { transform: translateY(0); }\n            to { transform: translateY(1px); }\n        }\n        @keyframes rattle {\n            0% { transform: rotate(0) translateY(0); }\n            25% { transform: rotate(-2deg) translateY(-1px); }\n            50% { transform: rotate(0) translateY(0); }\n            75% { transform: rotate(2deg) translateY(-1px); }\n            100% { transform: rotate(0) translateY(0); }\n        }\n        @keyframes rise {\n            0% { transform: translateY(0); opacity: 0.8; height: 4px; }\n            100% { transform: translateY(-15px); opacity: 0; height: 12px; }\n        }\n\n        /* --- CONTENU --- */\n        .content-wrapper {\n            flex: 1;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            overflow: hidden;\n        }\n\n        .col {\n            padding: 25px;\n            overflow-y: auto;\n            border-right: 1px solid rgba(255,255,255,0.05);\n            display: flex;\n            flex-direction: column;\n        }\n        .col:last-child { border-right: none; }\n\n        h3 {\n            font-family: 'Oswald', sans-serif;\n            color: var(--copper);\n            font-size: 1.1rem;\n            margin-bottom: 15px;\n            text-transform: uppercase;\n            display: flex;\n            align-items: center;\n            gap: 10px;\n        }\n        h3::after { content: ''; flex: 1; height: 1px; background: rgba(255,255,255,0.1); }\n\n        /* Liste Horaires */\n        .hours-list { list-style: none; font-size: 0.9rem; }\n        .hours-list li {\n            display: flex; justify-content: space-between;\n            padding: 8px 0;\n            border-bottom: 1px solid rgba(255,255,255,0.05);\n        }\n        .day { color: var(--text-main); font-weight: 500; }\n        .time { color: var(--text-muted); font-family: 'Montserrat', monospace; font-size: 0.85rem;}\n        .closed { color: #888; font-style: italic; font-size: 0.8rem; }\n\n        /* Highlight Jour J */\n        .today-highlight {\n            border-left: 3px solid var(--copper);\n            padding-left: 10px !important;\n            background: linear-gradient(90deg, rgba(205, 127, 50, 0.1), transparent);\n        }\n        .today-highlight .day { color: var(--copper-light); }\n        .today-highlight .time { color: white; }\n\n        /* Services & Contact */\n        .tags-container { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px; }\n        .srv-tag {\n            border: 1px solid var(--copper);\n            color: var(--copper-light);\n            padding: 5px 12px;\n            font-size: 0.7rem;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n            border-radius: 2px;\n        }\n\n        .contact-stack { display: flex; flex-direction: column; gap: 12px; }\n        .contact-item { display: flex; align-items: flex-start; gap: 12px; color: var(--text-muted); text-decoration: none; transition: 0.2s; }\n        .contact-item:hover { color: white; }\n        .contact-item svg { width: 18px; height: 18px; fill: var(--copper); margin-top: 2px; flex-shrink: 0;}\n        \n        .contact-text { display: flex; flex-direction: column; }\n        .contact-label { font-size: 0.65rem; text-transform: uppercase; color: #666; letter-spacing: 1px;}\n        .contact-value { font-size: 0.95rem; font-weight: 500; line-height: 1.3; }\n\n        /* Box Distributeur */\n        .metal-box {\n            margin-top: 25px;\n            background: linear-gradient(145deg, #222, #1a1a1a);\n            border: 1px solid #333;\n            padding: 12px;\n            border-radius: 4px;\n            position: relative;\n            box-shadow: inset 0 0 20px rgba(0,0,0,0.5);\n        }\n        .metal-box::before {\n            content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%;\n            background: repeating-linear-gradient(45deg, var(--copper), var(--copper) 5px, #222 5px, #222 10px);\n        }\n        .metal-box strong { display: block; color: var(--copper-light); font-family: 'Oswald'; letter-spacing: 1px; margin-bottom: 3px; font-size: 0.9rem;}\n        .metal-box em { color: #888; font-style: normal; font-size: 0.8rem; }\n\n        /* Footer */\n        footer {\n            flex: 0 0 auto;\n            text-align: center;\n            padding: 10px;\n            font-size: 0.7rem;\n            color: #555;\n            border-top: 1px solid rgba(255,255,255,0.05);\n        }\n        .legal-link { color: #777; text-decoration: none; background: transparent; border:none; border-bottom:1px dotted #777; cursor:pointer;}\n        .legal-link:hover { color: var(--copper); border-color: var(--copper); }\n\n        /* Toast & Modal */\n        #toast-notification {\n            visibility: hidden; min-width: 250px; background-color: #1a1a1a; color: #E0E0E0;\n            text-align: center; border: 1px solid var(--copper); border-radius: 4px; padding: 16px;\n            position: fixed; z-index: 1000; left: 50%; bottom: 30px; transform: translateX(-50%);\n            box-shadow: 0 4px 15px rgba(0,0,0,0.5); opacity: 0; transition: opacity 0.3s, bottom 0.3s;\n            font-family: 'Oswald', sans-serif; letter-spacing: 1px; font-size: 0.9rem;\n        }\n        #toast-notification.show { visibility: visible; opacity: 1; bottom: 50px; }\n\n        .modal { display: none; position: fixed; z-index: 100; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); backdrop-filter: blur(5px); align-items: center; justify-content: center; }\n        .modal-content { background: #1a1a1a; border: 1px solid var(--copper); padding: 30px; width: 90%; max-width: 400px; color: #ccc; box-shadow: 0 0 30px rgba(0,0,0,0.8); }\n        .close { float: right; font-size: 28px; cursor: pointer; color: var(--copper); }\n\n        @media (max-width: 800px) {\n            .content-wrapper { grid-template-columns: 1fr; }\n            .col { padding: 20px; border-right: none; border-bottom: 1px solid rgba(255,255,255,0.05); }\n            .glass-panel { max-height: 100vh; height: 100vh; border: none; border-radius: 0; }\n            h1 { font-size: 1.8rem; }\n            .col { max-height: 50vh; } \n            body { padding: 0; }\n        }\n    </style>\n</head>\n<body>\n\n    <div class=\"glass-panel\">\n        <header>\n            <div class=\"screw tl\"></div>\n            <div class=\"screw tr\"></div>\n            \n            <div class=\"blueprint-scene\">\n                <div class=\"bp-steam\"></div>\n                <div class=\"bp-steam\"></div>\n                <div class=\"bp-lid\"></div>\n                <div class=\"bp-pot\"></div>\n            </div>\n\n            <h1>Auberge de l'Est à l'Ouest</h1>\n            <div class=\"subtitle\">SITE EN CONSTRUCTION</div>\n        </header>\n\n        <div class=\"content-wrapper\">\n            \n            <div class=\"col\">\n                <h3>Horaires d'Ouverture</h3>\n                <ul class=\"hours-list\">\n                    <li><span class=\"day\">Lundi</span> <span class=\"time\">12:00 – 14:00</span></li>\n                    <li><span class=\"day\">Mardi</span> <span class=\"time\">12:00 – 14:00</span></li>\n                    <li><span class=\"day\">Mercredi</span> <span class=\"time\">12:00 – 14:00</span></li>\n                    <li><span class=\"day\">Jeudi</span> <span class=\"time\">12:00 – 14:30</span></li>\n                    <li><span class=\"day\">Vendredi</span> <span class=\"time\">12:00 – 14:00</span></li>\n                    <li><span class=\"day\">Samedi</span> <span class=\"closed\">Fermé</span></li>\n                    <li><span class=\"day\">Dimanche</span> <span class=\"closed\">Fermé</span></li>\n                </ul>\n            </div>\n\n            <div class=\"col\">\n                <h3>Nos Services</h3>\n                <div class=\"tags-container\">\n                    <span class=\"srv-tag\">Restaurant</span>\n                    <span class=\"srv-tag\">Traiteur</span>\n                    <span class=\"srv-tag\">À Emporter</span>\n                </div>\n\n                <h3>Nous Trouver & Contacter</h3>\n              