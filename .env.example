# Runtime
NODE_ENV=development

# Safety switches
MAGICSCRIPT_AUTOPILOT_ENABLED=false
MAGICSCRIPT_SENDING_ENABLED=false
MAGICSCRIPT_PROTOTYPE_DEPLOY_ENABLED=false

# Outreach guardrails
MAGICSCRIPT_DAILY_SEND_LIMIT=10
MAGICSCRIPT_MAX_FOLLOWUPS=2
MAGICSCRIPT_FOLLOWUP_1_DAYS=3
MAGICSCRIPT_FOLLOWUP_2_DAYS=5
MAGICSCRIPT_JOB_LEASE_MINUTES=30
MAGICSCRIPT_MIN_CONTACT_CONFIDENCE=80
MAGICSCRIPT_MIN_OUTREACH_CONFIDENCE=85
MAGICSCRIPT_AUTO_PROTOTYPE_SCORE=85
MAGICSCRIPT_MIN_QUALIFY_SCORE=65

# Persistence
MAGICSCRIPT_DATABASE_PROVIDER=memory
MAGICSCRIPT_DATABASE_URL=

# Control plane
MAGICSCRIPT_API_BASE_URL=
MAGICSCRIPT_PUBLIC_BASE_URL=
MAGICSCRIPT_API_TOKEN=
MAGICSCRIPT_RUNNER_TOKEN=
MAGICSCRIPT_QUOTE_VAT_NOTE=
MAGICSCRIPT_QUOTE_CGV_REFERENCE=
MAGICSCRIPT_CONTROL_CENTER_ORIGIN=

# Discovery
MAGICSCRIPT_TARGET_LOCATION=Martinique
MAGICSCRIPT_DISCOVERY_BATCH_SIZE=20

# Agent runner
MAGICSCRIPT_REPO_DIR=
MAGICSCRIPT_RUNNER_WORK_DIR=
MAGICSCRIPT_RUNNER_ID=
MAGICSCRIPT_POLL_INTERVAL_MS=5000
MAGICSCRIPT_SWARM_MAX_CONCURRENCY=8
KIMI_EXECUTABLE=kimi

# Email provider
# Keep disabled until real outbound activation is explicitly approved.
MAGICSCRIPT_EMAIL_PROVIDER=disabled
MAGICSCRIPT_TEST_EMAIL_MODE=false
MAGICSCRIPT_TEST_RECIPIENT=
MAGICSCRIPT_FROM_EMAIL=
MAGICSCRIPT_REPLY_TO_EMAIL=
MAGICSCRIPT_EMAIL_USERNAME=
MAGICSCRIPT_EMAIL_PASSWORD=
MAGICSCRIPT_EMAIL_SIGNATURE=
MAGICSCRIPT_INBOX_POLL_MS=60000

# Amen mailbox defaults
AMEN_SMTP_HOST=smtp-fr.securemail.pro
AMEN_SMTP_PORT=465
AMEN_IMAP_HOST=mail-fr.securemail.pro
AMEN_IMAP_PORT=993

# Optional future provider keys
# Never commit real secrets.

# Hunter free fallback
# Keep the real API key in a local secret / Cloudflare Worker secret, never Git.
HUNTER_API_KEY=
# Reserve some of the 50 free monthly credits instead of consuming the full allowance.
HUNTER_MONTHLY_CREDIT_BUDGET=40

# INSEE Sirene free discovery
# Free public API key from the INSEE API catalogue.
# Keep it as a runtime secret even though the plan is public/free.
INSEE_SIRENE_API_KEY=
