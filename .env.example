# Runtime
NODE_ENV=development

# Safety switches
MAGICSCRIPT_AUTOPILOT_ENABLED=false
MAGICSCRIPT_SENDING_ENABLED=false
MAGICSCRIPT_PROTOTYPE_DEPLOY_ENABLED=false

# Outreach guardrails
MAGICSCRIPT_DAILY_SEND_LIMIT=10
MAGICSCRIPT_MAX_FOLLOWUPS=2
MAGICSCRIPT_MIN_CONTACT_CONFIDENCE=80
MAGICSCRIPT_MIN_OUTREACH_CONFIDENCE=85
MAGICSCRIPT_AUTO_PROTOTYPE_SCORE=85

# Persistence
MAGICSCRIPT_DATABASE_PROVIDER=memory
MAGICSCRIPT_DATABASE_URL=

# Control plane
MAGICSCRIPT_API_BASE_URL=
MAGICSCRIPT_API_TOKEN=
MAGICSCRIPT_RUNNER_TOKEN=
MAGICSCRIPT_CONTROL_CENTER_ORIGIN=

# Agent runner
MAGICSCRIPT_REPO_DIR=
MAGICSCRIPT_RUNNER_WORK_DIR=
MAGICSCRIPT_POLL_INTERVAL_MS=5000
KIMI_EXECUTABLE=kimi

# Email provider
MAGICSCRIPT_EMAIL_PROVIDER=disabled
MAGICSCRIPT_FROM_EMAIL=
MAGICSCRIPT_REPLY_TO_EMAIL=

# Optional future provider keys
# Never commit real secrets.
