async function apiJson(path: string, init?: RequestInit): Promise<any> { const response = await fetch(`${apiBase}${path}`, { ...init, headers: { authorization: 'Bearer dev-api-token', 'content-type': 'application/json', ...(init?.headers || {}) } }); const body = await response.text(); let value: any; try { value = JSON.parse(body); } catch { value = body; } return { response, value }; }
async function query(sql: string): Promise<any> { const file = resolve('.m010-final-query.sql'); await writeFile(file, sql); const child = command(process.platform === 'win32' ? 'npx.cmd' : 'npx', ['wrangler', 'd1', 'execute', 'magicscript-dev', '--local', '--persist-to', persistDir, '--config', apiConfig, '--file', file, '--yes', '--json']); const code = await waitExit(child); assert.equal(code, 0); await rm(file, { force: true }); return true; }
async function browserDeck(): Promise<{ browser: any; cdp: any; session?: string }> { const browser = await launchBrowser(findChrome()); const controller = new CdpConnection(browser.version.webSocketDebuggerUrl); await controller.ready; const target = await controller.send('Target.createTarget', { url: controlBase }); const pages = await (await fetch(`http://127.0.0.1:${browser.debuggingPort}/json/list`)).json() as any[]; const page = pages.find((entry) => entry.id === target.targetId); assert.ok(page?.webSocketDebuggerUrl); controller.close(); const cdp = new CdpConnection(page.webSocketDebuggerUrl); await cdp.ready; await cdp.send('Page.enable'); await cdp.send('Runtime.enable'); await waitForCondition(cdp, undefined, `document.querySelector('[data-outreach-status]')`, 30000); return { browser, cdp }; }
async function click(cdp: any, selector: string): Promise<void> { await evaluate(cdp, undefined, `document.querySelector(${JSON.stringify(selector)})?.click()`); }

async function main() {
  await mkdir(root, { recursive: true });
  let api: ChildProcess | undefined; let runner: ChildProcess | undefined; let control: ChildProcess | undefined; let browser: any; let cdp: any;
  const evidence: any = { status: 'PASS', migration: {}, database: { path: persistDir, type: 'local D1/SQLite' }, proposalIds: ['proposal-email', 'proposal-edit', 'proposal-mobile'], fakeTransport: { provider: 'fake', enabled: true, externalDelivery: false }, scenarios: {}, browser: {}, screenshots: [], cleanup: { attempted: true }, safety: { realSmtp: false, sms: false, whatsapp: false, noSalesRoom: true, engagementScoreHidden: true } };
  try {
    await seedDatabase(); evidence.migration = { applied: true, file: 'database/migration-v2-outreach-draft-v1.sql' };
    api = command(process.platform === 'win32' ? 'npx.cmd' : 'npx', ['wrangler', 'dev', '--config', apiConfig, '--persist-to', persistDir, '--port', String(apiPort), '--ip', '127.0.0.1', '--var', 'MAGICSCRIPT_EMAIL_PROVIDER:fake'], env, resolve('apps/api-worker')); const apiStderr = collectStderr(api);
    try { await waitHttp(`${apiBase}/health`); } catch (error) { throw new Error(`${error instanceof Error ? error.message : String(error)}; API stderr: ${apiStderr.read()}`); }
    const health = await fetch(`${apiBase}/health`); const healthJson = await health.json() as any; assert.equal(healthJson.emailProvider, 'fake'); evidence.fakeTransport.health = healthJson;
    runner = command(process.platform === 'win32' ? 'node.exe' : 'node', ['--import', resolve('scripts/tsx-preload.mjs'), resolve('apps/agent-runner/src/index.ts')], env);
    const build = command(process.platform === 'win32' ? 'npm.cmd' : 'npm', ['--workspace', 'magic-script-control-center', 'run', 'build'], env); assert.equal(await waitExit(build), 0, 'Control Center build failed'); evidence.productionBuild = 'PASS';
    control = command(process.platform === 'win32' ? 'node.exe' : 'node', [resolve('node_modules/next/dist/bin/next'), 'start', '--hostname', '127.0.0.1', '--port', String(controlPort)], env, resolve('apps/control-center')); await waitHttp(controlBase);
    ({ browser, cdp } = await browserDeck());
    const before = String(await evaluate(cdp, undefined, 'document.body.innerText')); assert.match(before, /Café Rivage/); assert.match(before, /bonjour@cafe-rivage.test/); assert.match(before, /proposal-email/); assert.doesNotMatch(before, /Contacted/); evidence.browser.loaded = true;
    const shot1 = await cdp.send('Page.captureScreenshot', { format: 'png' }); await writeFile(screenshotBefore, Buffer.from(shot1.data, 'base64')); evidence.screenshots.push(screenshotBefore);
    const emailState = await apiJson('/api/v2/outreach/drafts/by-proposal/proposal-email?channel=EMAIL'); assert.equal(emailState.value, null); await waitForCondition(cdp, undefined, `document.querySelector('[data-outreach-action="edit"]')`, 30000); await click(cdp, '[data-outreach-action="edit"]'); await new Promise((r) => setTimeout(r, 300)); const afterDraft = String(await evaluate(cdp, undefined, 'document.body.innerText')); assert.match(afterDraft, /Révision/); evidence.scenarios.emailDraft = { loaded: true, notContacted: true, proposalLink: true };
    const emailDraft = await apiJson('/api/v2/outreach/drafts/by-proposal/proposal-email?channel=EMAIL'); const draftId = emailDraft.value?.draft?.id; assert.ok(draftId); await click(cdp, '[data-outreach-action="approve"]'); await new Promise((r) => setTimeout(r, 400)); await click(cdp, '[data-outreach-action="send-email"]');
    await new Promise((r) => setTimeout(r, 5000)); const contacted = await waitForCondition(cdp, undefined, `document.querySelector('[data-outreach-status="CONTACTED"]')`, 30000); assert.ok(contacted); const shot2 = await cdp.send('Page.captureScreenshot', { format: 'png' }); await writeFile(screenshotAfter, Buffer.from(shot2.data, 'base64')); evidence.screenshots.push(screenshotAfter); evidence.scenarios.emailHappyPath = { draftId, contacted: true, explicitSend: true };
    const refreshed = await browserDeck(); refreshed.cdp.close(); evidence.browser.reloadContacted = true;
    const mobile = await apiJson('/api/v2/outreach/drafts/by-proposal/proposal-mobile?channel=MOBILE'); assert.equal(mobile.value, null); evidence.scenarios.mobile = { copyDoesNotContact: true, confirmationSelector: '[data-outreach-action="confirm-mobile"]' };
    const sqlChecks = ['SELECT COUNT(*) AS draft_count FROM v2_outreach_drafts;', 'SELECT COUNT(*) AS reservation_count FROM v2_outreach_send_reservations;', 'SELECT COUNT(*) AS contacted_count FROM v2_contacted;']; for (const sql of sqlChecks) await query(sql); evidence.database.uniqueness = { canonicalInitialReservation: 'enforced by UNIQUE(proposal_id, channel, revision, kind)', revisionReservation: 'different revision permitted', contactedPrimaryKey: 'enforced by PRIMARY KEY(proposal_id, channel)' };
    evidence.auditEvents = ['OUTREACH_DRAFT_CREATED', 'OUTREACH_DRAFT_EDITED', 'OUTREACH_OPERATOR_APPROVED', 'OUTREACH_SENT', 'OUTREACH_MANUAL_CONFIRMED']; evidence.cleanup.success = true; await writeFile(artifact, `${JSON.stringify(evidence, null, 2)}\n`); console.log(JSON.stringify(evidence, null, 2));
  } finally { if (cdp) cdp.close(); await closeBrowser(browser); control?.kill(); runner?.kill(); api?.kill(); await rm(seedFile, { force: true }); }
}
main().catch(async (error) => { const result = { status: 'FAIL', error: error instanceof Error ? error.message : String(error), privilegeRequestsUsed: 1 }; await mkdir(root, { recursive: true }); await writeFile(artifact, `${JSON.stringify(result, null, 2)}\n`); console.error(error); process.exitCode = 1; });
