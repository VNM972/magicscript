function command(name: string, args: string[], extra: NodeJS.ProcessEnv = env, cwd = resolve('.')): ChildProcess { return spawn(name, args, { cwd, env: extra, stdio: ['ignore', 'ignore', 'pipe'], windowsHide: true, shell: process.platform === 'win32' }); }
function waitExit(child: ChildProcess): Promise<number> { return new Promise((resolveExit) => child.once('exit', (code) => resolveExit(code ?? 1))); }
function collectStderr(child: ChildProcess): { read: () => string } { let value = ''; child.stderr?.setEncoding('utf8'); child.stderr?.on('data', (chunk) => { value += chunk; }); return { read: () => value.slice(-4000) }; }
async function waitHttp(url: string, timeout = 30000): Promise<void> { const started = Date.now(); let last = ''; while (Date.now() - started < timeout) { try { const response = await fetch(url); if (response.ok) return; last = `HTTP ${response.status}: ${(await response.text()).slice(0, 500)}`; } catch (error) { last = String(error); } await new Promise((r) => setTimeout(r, 250)); } throw new Error(`Readiness failed for ${url}: ${last}`); }
async function runWrangler(args: string[], extraEnv = env): Promise<void> { const child = command(process.platform === 'win32' ? 'npx.cmd' : 'npx', ['wrangler', ...args], extraEnv); const code = await waitExit(child); assert.equal(code, 0, `wrangler ${args.join(' ')} failed`); }
